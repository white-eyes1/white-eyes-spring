# [해석본] 원본: .env.example (feature/15-cam-status-report 브랜치)
# [무엇] 로컬에서 쓸 환경변수 목록의 '빈 양식'. cp .env.example .env로 복사해 값은 .env에만 채운다(.env는 .gitignore에 있음).
# [#15에서 바꾼 것] 맨 아래 두 줄. CLAUDE.md 규칙 "새 변수는 .env.example에 이름만 추가한다"에 따라 값 없이 이름만 넣었다.
#   값을 넣지 않는 이유: 이 파일은 저장소에 올라가므로 토큰 같은 비밀값이 들어가면 그대로 공개된다.
# 복사해서 .env로 쓴다: cp .env.example .env  (값은 .env에만 채우고 커밋하지 않는다)

# MySQL 컨테이너 (docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Spring 앱 (user·admin 공통 이름, 앱마다 다른 값)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 로그 레벨 (local·dev: DEBUG, prod: INFO)
LOG_LEVEL=

# 분석 서버 주소·내부 토큰 (admin, conventions.md '설정값')
# [해석] admin/src/main/resources/application.yml의 analyzer.base-url, internal-api.token이 이 두 변수를 읽는다.
ANALYZER_BASE_URL=
INTERNAL_API_TOKEN=
