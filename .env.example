# 복사해서 .env로 쓴다: cp .env.example .env  (값은 .env에만 채우고 커밋하지 않는다)

# MySQL 컨테이너 (docker-compose.yml)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Spring 앱 (user·admin 공통 이름, 앱마다 다른 값)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 세션 만료 시간(user·admin). 기본값 30m을 쓰려면 주석으로 둔다 — 빈 값으로 두면 앱이 뜨지 않는다
# SESSION_TIMEOUT=30m

# 로그 레벨 (local·dev: DEBUG, prod: INFO)
LOG_LEVEL=

# 분석 서버 주소·내부 토큰 (admin, conventions.md '설정값')
ANALYZER_BASE_URL=
INTERNAL_API_TOKEN=

# 최고 관리자 최초 등록 (admin, 서버 첫 실행 때 한 번 사용)
SUPER_ADMIN_LOGIN_ID=
SUPER_ADMIN_INITIAL_PASSWORD=

# 혼잡 단계 경계 밀도(명/㎡, user·admin). 기본값 0.7 / 1.5를 쓰려면 주석으로 둔다 — 빈 값으로 두면 숫자로 읽지 못해 앱이 뜨지 않는다
# THRESHOLD_WARN_DENSITY=0.7
# THRESHOLD_DANGER_DENSITY=1.5

# 1분 마감 대기 시간(초, admin). 기본값 5를 쓰려면 주석으로 둔다 — 빈 값으로 두면 숫자로 읽지 못해 앱이 뜨지 않는다
# MINUTE_CLOSE_GRACE_SEC=5

# 혼잡 이벤트 판정(admin, FNC-A-033). 기본값을 쓰려면 주석으로 둔다 — 빈 값으로 두면 숫자로 읽지 못해 앱이 뜨지 않는다
# 1분 통계의 결과 초 수가 이보다 적으면 이벤트 검사를 건너뜀(초)
# EVENT_MIN_SAMPLE_SEC=30
# 주의 미만이 이 시간 이상 이어지면 이벤트 종료(분)
# EVENT_CLOSE_HOLD_MIN=5
