# 형식 기준(code-conventions.md 2-2). Java·JS의 세부 형식은 Spotless·Prettier가 맞춘다
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# 줄 끝 공백 두 칸은 마크다운 줄바꿈이다
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
